<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sample only. NSAppTransportSecurity: lets it reach a test server on this Mac (http://localhost); your own app needs none of it. NSCameraUsageDescription: needed for "Take a photo" in the chat. UIFileSharingEnabled + LSSupportsOpeningDocumentsInPlace: only so test files copied into the sample show in the Files app. -->
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>To send a photo to our support team in the chat.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UIFileSharingEnabled</key>
	<true/>
</dict>
</plist>
